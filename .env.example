# ----------------------------------------------------------------------------
# Under One Roof — environment variables (EXAMPLE)
# Copy to `.env.local` and fill in. NEVER commit real values; `.env*` is
# already in .gitignore. The app runs entirely on mock data for the MVP, so
# none of these are required yet.
#
# CRITICAL: With Vite, ONLY variables prefixed with VITE_ are exposed to the
# browser, and anything in the frontend bundle is PUBLIC. Never put a service
# role key, database password, or AI key in a VITE_ variable. Those belong ONLY
# in a server / edge function. See docs/10_SECURITY_PRIVACY.md.
# ----------------------------------------------------------------------------

# --- Safe to expose (public) ---
VITE_APP_NAME="Under One Roof"
VITE_APP_ENV="development"

# Supabase public, anon-scoped values (safe in the browser). Left blank for the
# MVP — fill these only when you wire up a real backend in Phase 2.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ----------------------------------------------------------------------------
# --- SERVER-SIDE ONLY — never prefix these with VITE_, never read them from
#     browser code. They must live only in a server / edge function. ---
# ----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=""   # full DB access — keep off the client entirely
# AI_API_KEY=""                  # AI provider key — browser never sees this
# AI_MODEL=""
# STORAGE_BUCKET_NAME="home-documents"   # PRIVATE bucket; serve via signed URLs
